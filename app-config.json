{
  "app_name": "KSP Crime Intelligence Platform",
  "app_version": "1.0.0",
  "description": "AI-powered crime intelligence and analytics platform for Karnataka State Police",
  "appsail": {
    "name": "ksp-frontend",
    "stack": "node18",
    "memory": 512,
    "build": {
      "command": "npm install && npm run build",
      "output_directory": "dist"
    },
    "serve": {
      "command": "npx serve dist -l 3000 --single",
      "port": 3000
    },
    "environment_variables": {
      "VITE_CATALYST_PROJECT_ID": "YOUR_CATALYST_PROJECT_ID",
      "VITE_CATALYST_CLIENT_ID": "YOUR_CATALYST_CLIENT_ID",
      "NODE_ENV": "production"
    }
  },
  "datastore": {
    "tables": [
      {
        "table_name": "ksp_audit_log",
        "columns": [
          { "column_name": "user_id", "data_type": "TEXT" },
          { "column_name": "user_name", "data_type": "TEXT" },
          { "column_name": "action", "data_type": "TEXT" },
          { "column_name": "category", "data_type": "TEXT" },
          { "column_name": "detail", "data_type": "TEXT" },
          { "column_name": "timestamp", "data_type": "TEXT" }
        ]
      },
      {
        "table_name": "ksp_alerts",
        "columns": [
          { "column_name": "severity", "data_type": "TEXT" },
          { "column_name": "title", "data_type": "TEXT" },
          { "column_name": "message", "data_type": "TEXT" },
          { "column_name": "district_id", "data_type": "TEXT" },
          { "column_name": "category", "data_type": "TEXT" },
          { "column_name": "dismissed", "data_type": "BOOLEAN" }
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "ksp-ai-query",
      "description": "Handles AI chatbot queries with RAG pipeline",
      "runtime": "nodejs18",
      "handler": "catalyst-functions/ai-query/index.handler",
      "memory": 256,
      "timeout": 30
    },
    {
      "name": "ksp-forecast",
      "description": "Crime forecast model serving via Catalyst QuickML",
      "runtime": "nodejs18",
      "handler": "catalyst-functions/forecast/index.handler",
      "memory": 256,
      "timeout": 30
    },
    {
      "name": "ksp-alerts-cron",
      "description": "Scheduled alert generation from crime data",
      "runtime": "nodejs18",
      "handler": "catalyst-functions/alerts-cron/index.handler",
      "memory": 128,
      "timeout": 60
    }
  ],
  "cron": [
    {
      "name": "ksp-daily-alerts",
      "description": "Generate daily crime alerts at 6 AM IST",
      "function": "ksp-alerts-cron",
      "schedule": "0 0 30 * * ? *"
    }
  ],
  "cache": {
    "name": "ksp-cache",
    "ttl": 3600,
    "keys": ["ksp:kpis", "ksp:hotspots", "ksp:forecast", "ksp:network"]
  },
  "signals": {
    "topics": [
      { "name": "ksp-critical-alerts", "description": "Real-time critical crime alerts" },
      { "name": "ksp-case-updates", "description": "Case status change notifications" }
    ]
  },
  "stratus": {
    "buckets": [
      { "name": "ksp-reports", "description": "Generated PDF reports storage" },
      { "name": "ksp-evidence", "description": "Case evidence file storage" }
    ]
  },
  "quickml": {
    "models": [
      {
        "name": "ksp-crime-forecast",
        "description": "XGBoost crime volume forecasting model",
        "type": "regression",
        "features": ["month", "district_id", "crime_category", "season", "year"]
      },
      {
        "name": "ksp-risk-score",
        "description": "Offender recidivism risk scoring model",
        "type": "classification",
        "features": ["priors_count", "age", "gang_affiliation", "status", "avg_case_severity"]
      }
    ]
  },
  "smartbrowz": {
    "description": "Used for server-side PDF generation of case and investigation reports",
    "endpoints": [
      "/api/reports/case/:id",
      "/api/reports/investigation/:id",
      "/api/reports/dashboard"
    ]
  }
}
